---
import Icon from "./Icon.astro";
---
<div class="theme-dock" role="region" aria-label="Site controls">
  <div class="dock" id="theme-dock">
    <div class="dock-bar">
      <button
        id="td-searchbtn"
        type="button"
        aria-expanded="false"
        aria-controls="td-search-pane"
        aria-label="Search posts"
        title="Search posts"
      >
        <Icon name="search" />
      </button>

      <button
        id="td-theme"
        type="button"
        aria-expanded="false"
        aria-controls="td-theme-pane"
        aria-label="Open theme settings"
        title="Theme settings"
      >
        <Icon name="palette" />
      </button>

      <button
        id="td-fxbtn"
        type="button"
        aria-expanded="false"
        aria-controls="td-fx-pane"
        aria-label="Open cursor and background effects"
        title="Cursor and background effects"
      >
        <Icon name="star" />
      </button>
    </div>

    <div class="dock-panes">
      <div class="dock-clip">
        <div class="dock-pane dock-pane-stack" id="td-search-pane" hidden>
          <input
            id="td-search-input"
            class="dock-search-input"
            type="search"
            placeholder="Search posts…"
            autocomplete="off"
            spellcheck="false"
            aria-label="Search posts"
            aria-controls="td-search-results"
          />
          <div id="td-search-results" class="dock-search-results"></div>
          <p id="td-search-status" class="dock-search-status" aria-live="polite"></p>
        </div>

        <div class="dock-pane dock-pane-grid" id="td-theme-pane" hidden>
          <button
            id="td-mode-toggle"
            class="dock-pill"
            type="button"
            aria-pressed="false"
            title="Light / dark mode"
          >
            <span class="dock-pill-box" aria-hidden="true">
              <span data-icon-light><Icon name="light-mode" /></span>
              <span data-icon-dark hidden><Icon name="dark-mode" /></span>
            </span>
            <span class="dock-pill-text">Light mode</span>
          </button>
          <button
            id="td-reset"
            class="dock-pill"
            type="button"
            aria-label="Reset theme to defaults"
            title="Reset theme to defaults"
          >
            <span class="dock-pill-box" aria-hidden="true"><Icon name="restart-alt" /></span>
            <span class="dock-pill-text">Reset</span>
          </button>
          <label class="dock-hue" for="td-hue" title="Accent hue">
            <span class="dock-swatch" aria-hidden="true"></span>
            <input
              class="md-slider md-slider-hue dock-slider"
              type="range"
              id="td-hue"
              min="0"
              max="360"
              step="1"
              value="260"
              aria-label="Accent hue"
            />
            <output id="td-hue-val" for="td-hue">260°</output>
          </label>
          <label class="dock-sel" title="Scheme variant">
            <Icon name="tune" />
            <select id="td-variant" aria-label="Scheme variant">
              <option value="tonalSpot">Tonal spot</option>
              <option value="expressive">Expressive</option>
              <option value="vibrant">Vibrant</option>
              <option value="neutral">Neutral</option>
              <option value="fidelity">Fidelity</option>
              <option value="rainbow">Rainbow</option>
              <option value="fruitSalad">Fruit salad</option>
            </select>
            <Icon name="expand-more" class="dock-chev" />
          </label>
        </div>

        <div class="dock-pane" id="td-fx-pane" hidden>
          <button
            id="td-cursor"
            class="dock-pane-btn"
            type="button"
            aria-pressed="true"
            aria-label="Toggle the custom cursor"
            title="Custom cursor"
          >
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M3 3l18 9-7 1.2L11 21z" />
            </svg>
            <span>Cursor</span>
          </button>
          <label class="dock-sel" title="Background animation">
            <Icon name="star" />
            <select id="td-fx" aria-label="Background animation">
              <option value="honeycomb">Honeycomb</option>
              <option value="dots">Dot matrix</option>
              <option value="shapes">M3 shapes</option>
              <option value="circuit">Circuit traces</option>
              <option value="off">No background</option>
            </select>
            <Icon name="expand-more" class="dock-chev" />
          </label>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const hue = document.getElementById("td-hue");
    const hueVal = document.getElementById("td-hue-val");
    const variant = document.getElementById("td-variant");
    const modeBtn = document.getElementById("td-mode-toggle");
    const modeText = modeBtn && modeBtn.querySelector(".dock-pill-text");
    const resetBtn = document.getElementById("td-reset");
    if (!window.M3Theme || !hue || !variant || !modeBtn || !resetBtn) return;
    const st = window.M3Theme.state;
    let darkOn = !!st.dark;
    hue.value = String(st.hue);
    variant.value = st.variant;
    // The toggle names and pictures the mode you are in ("Light mode" / sun,
    // "Dark mode" / moon) and is pressed while the dark theme is on.
    const syncBtn = () => {
      modeBtn.setAttribute("aria-pressed", String(darkOn));
      modeBtn.querySelector("[data-icon-dark]").hidden = !darkOn;
      modeBtn.querySelector("[data-icon-light]").hidden = darkOn;
      if (modeText) modeText.textContent = darkOn ? "Dark mode" : "Light mode";
    };
    const paint = () => {
      hueVal.textContent = hue.value + "°";
      window.M3Theme.apply({
        hue: Number(hue.value),
        chroma: st.chroma,
        variant: variant.value,
        dark: darkOn,
        spec: st.spec,
      });
      document.dispatchEvent(new CustomEvent("m3-theme-change"));
    };
    hue.addEventListener("input", paint);
    variant.addEventListener("change", paint);
    modeBtn.addEventListener("click", () => {
      darkOn = !darkOn;
      syncBtn();
      paint();
    });
    resetBtn.addEventListener("click", () => {
      try { localStorage.removeItem("m3-theme-v1"); } catch {}
      hue.value = "260";
      variant.value = "tonalSpot";
      darkOn = !!(window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches);
      st.chroma = 48;
      st.spec = "2021";
      syncBtn();
      paint();
    });
    syncBtn();
    paint();
  })();
</script>

<script is:inline>
  (() => {
    const fxSel = document.getElementById("td-fx");
    const cursorBtn = document.getElementById("td-cursor");
    if (!fxSel || !cursorBtn) return;
    const KEY = "m3-fx-v1";
    const saved = (() => {
      try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch { return {}; }
    })();
    const st = Object.assign({ effect: "honeycomb", cursor: true }, saved);
    const save = () => {
      try { localStorage.setItem(KEY, JSON.stringify(st)); } catch {}
    };
    const sync = () => {
      fxSel.value = st.effect;
      cursorBtn.setAttribute("aria-pressed", String(!!st.cursor));
    };
    const broadcast = () => {
      save();
      document.dispatchEvent(new CustomEvent("m3-fx-change", { detail: { ...st } }));
    };
    fxSel.addEventListener("change", () => {
      st.effect = fxSel.value;
      broadcast();
    });
    cursorBtn.addEventListener("click", () => {
      st.cursor = !st.cursor;
      sync();
      broadcast();
    });
    document.addEventListener("m3-fx-ready", (e) => {
      Object.assign(st, e.detail || {});
      sync();
    });
    sync();
  })();
</script>

<script is:inline>
  (() => {
    const dock = document.getElementById("theme-dock");
    const searchBtn = document.getElementById("td-searchbtn");
    const themeBtn = document.getElementById("td-theme");
    const fxBtn = document.getElementById("td-fxbtn");
    if (!dock || !searchBtn || !themeBtn || !fxBtn) return;
    const panes = {
      search: document.getElementById("td-search-pane"),
      theme: document.getElementById("td-theme-pane"),
      fx: document.getElementById("td-fx-pane"),
    };
    const triggers = { search: searchBtn, theme: themeBtn, fx: fxBtn };
    const canHover = window.matchMedia("(hover: hover)").matches;

    let hideTimer = 0;
    const apply = (name) => {
      window.clearTimeout(hideTimer);
      Object.entries(panes).forEach(([k, p]) => {
        if (!p || k === name) return;
        if (name) { p.hidden = true; return; } // switching panes: swap at once
        if (!p.hidden) hideTimer = window.setTimeout(() => { p.hidden = true; }, 520);
      });
      if (name && panes[name]) panes[name].hidden = false;
      Object.entries(triggers).forEach(([k, b]) => b.setAttribute("aria-expanded", String(k === name)));
      dock.classList.toggle("is-open", !!name);
    };
    const open = (name) => { if (panes[name]) apply(name); };
    const toggle = (name) => { apply(panes[name] && panes[name].hidden ? name : null); };
    const close = () => apply(null);
    const paneFocused = () => {
      const a = document.activeElement;
      return !!a && !!a.closest && !!a.closest(".dock-pane:not([hidden])");
    };

    Object.entries(triggers).forEach(([name, btn]) => {
      btn.addEventListener("click", () => { canHover ? open(name) : toggle(name); });
    });

    if (canHover) {
      Object.entries(triggers).forEach(([name, btn]) => {
        btn.addEventListener("mouseenter", () => open(name));
      });
      dock.addEventListener("mouseleave", () => { if (!paneFocused()) close(); });
    }

    dock.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (!dock.contains(document.activeElement)) close();
      });
    });
    dock.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
  })();
</script>

<script is:inline>
  (() => {
    const pane = document.getElementById("td-search-pane");
    const input = document.getElementById("td-search-input");
    const list = document.getElementById("td-search-results");
    const status = document.getElementById("td-search-status");
    if (!pane || !input || !list || !status) return;
    const MAX = 6;
    const esc = (s) =>
      String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    let posts = null;
    let loading = false;
    let hits = [];
    let active = -1;

    // The index is fetched the first time the pane opens, then reused.
    const load = () => {
      if (posts || loading) return;
      loading = true;
      fetch("/search-index.json")
        .then((r) => r.json())
        .then((data) => {
          posts = Array.isArray(data) ? data : [];
          render();
        })
        .catch(() => {
          status.textContent = "Search index failed to load.";
        });
    };

    const paint = () => {
      [...list.children].forEach((el, i) => el.classList.toggle("is-active", i === active));
      const el = list.children[active];
      if (el && el.scrollIntoView) el.scrollIntoView({ block: "nearest" });
    };

    const render = () => {
      if (!posts) return;
      const q = input.value.trim().toLowerCase();
      const matched = q
        ? posts.filter((p) => [p.title, p.description, (p.tags || []).join(" ")].join(" ").toLowerCase().includes(q))
        : posts;
      hits = matched.slice(0, MAX);
      active = hits.length ? 0 : -1;
      list.innerHTML = hits
        .map(
          (p, i) =>
            `<a class="dock-search-result${i === 0 ? " is-active" : ""}" href="/blog/${esc(p.slug)}">` +
            `<span class="dock-search-title">${esc(p.title)}</span>` +
            `<span class="dock-search-date">${esc(p.pubDate)}</span></a>`
        )
        .join("");
      list.hidden = !hits.length;
      status.textContent = q
        ? hits.length
          ? `${hits.length} match${hits.length === 1 ? "" : "es"} · ↑↓ then Enter`
          : "No matching posts"
        : `${posts.length} post${posts.length === 1 ? "" : "s"} · ↑↓ then Enter`;
    };

    input.addEventListener("focus", load);
    input.addEventListener("input", () => {
      load();
      render();
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        if (!hits.length) return;
        e.preventDefault();
        active = (active + (e.key === "ArrowDown" ? 1 : -1) + hits.length) % hits.length;
        paint();
      } else if (e.key === "Enter") {
        const hit = hits[active] || hits[0];
        if (hit) {
          e.preventDefault();
          window.location.href = "/blog/" + hit.slug;
        }
      }
    });
    new MutationObserver(() => {
      if (!pane.hidden) load();
    }).observe(pane, { attributes: true, attributeFilter: ["hidden"] });
  })();
</script>
