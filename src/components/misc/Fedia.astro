---
interface Props {
  url: string;
  class?: string;
}

const { url, class: className } = Astro.props;

interface Author {
  name?: string;
  preferredUsername?: string;
  url?: string;
  icon?: { url?: string } | string;
}

interface Tag {
  type: string;
  href?: string;
  name?: string;
}

interface Post {
  type: string;
  content?: string;
  published?: string;
  attributedTo?: Author | string;
  url?: string;
  tag?: Tag[];
  summary?: string;
  sensitive?: boolean;
}

let post: Post | null = null;

const displayName = new URL(url).hostname;

try {
  const response = await fetch(url, {
    headers: {
      Accept:
        'application/activity+json, application/ld+json; profile="https://www.w3.org/ns/activitystreams"',
    },
    signal: AbortSignal.timeout(10000),
  });

  if (response.ok) {
    const data: Post = await response.json();
    const validTypes = [
      "Note",
      "Article",
      "Page",
      "Question",
      "Video",
      "Audio",
      "Document",
      "Image",
    ];
    if (data.type && validTypes.includes(data.type)) {
      post = data;
    }
  }
} catch {}

if (post && typeof post.attributedTo === "string") {
  try {
    const authorResponse = await fetch(post.attributedTo, {
      headers: {
        Accept:
          'application/activity+json, application/ld+json; profile="https://www.w3.org/ns/activitystreams"',
      },
      signal: AbortSignal.timeout(5000),
    });
    if (authorResponse.ok) {
      post.attributedTo = await authorResponse.json();
    }
  } catch {}
}

const authorData =
  post?.attributedTo && typeof post.attributedTo === "object"
    ? post.attributedTo
    : null;
const authorName =
  authorData?.name || authorData?.preferredUsername || "";
const authorHandle = authorData?.preferredUsername
  ? `@${authorData.preferredUsername}`
  : "";
const authorUrl = authorData?.url || "";
const authorAvatar =
  typeof authorData?.icon === "string"
    ? authorData.icon
    : authorData?.icon?.url || "";
const publishedDate = post?.published
  ? new Date(post.published)
  : null;
const postUrl = post?.url || url;
const hashtags =
  post?.tag?.filter((t) => t.type === "Hashtag") || [];

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

const isSensitive = post?.sensitive === true;
const contentWarning = post?.summary || "";
---

<div class:list={["fedia-embed not-prose", className]}>
  {post ? (
    <div class="fedia-card">
      <img class="fedia-favicon" src="https://fedia.social/favicon.ico" alt="" width="24" height="24" loading="lazy" />
      <div class="fedia-card-header">
        {authorAvatar && (
          <img
            class="fedia-avatar"
            src={authorAvatar}
            alt=""
            width="44"
            height="44"
            loading="lazy"
          />
        )}
        <div class="fedia-author">
          {authorName && (
            <a
              class="fedia-name transition text-90 hover:text-[var(--primary)]"
              href={authorUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {authorName}
            </a>
          )}
          {authorHandle && (
            <span class="fedia-handle text-50">{authorHandle}</span>
          )}
        </div>
        {authorUrl && (
          <a
            class="fedia-follow-btn"
            href={authorUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Follow
          </a>
        )}
      </div>

      {isSensitive && contentWarning && (
        <div class="fedia-cw">
          <span class="fedia-cw-label">
            Content warning: {contentWarning}
          </span>
        </div>
      )}

      {post.content && (
        <div class="fedia-content">
          <Fragment set:html={post.content} />
        </div>
      )}

      {/* NOTE: these lines are redundant, as post.content contains the hashtags too. */}
      {/* 
      {hashtags.length > 0 && (
        <div class="fedia-hashtags">
          {hashtags.map((tag) => (
            <a
              class="fedia-hashtag"
              href={tag.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {tag.name}
            </a>
          ))}
        </div>
      )}
      */}

      {publishedDate && (
        <a
          class="fedia-date text-50 hover:text-[var(--primary)]"
          href={postUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {formatDate(publishedDate)}
        </a>
      )}

      <div class="fedia-footer">
        <a
          class="fedia-link"
          href={postUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          View on {displayName}
        </a>
      </div>
    </div>
  ) : (
    <div class="fedia-card fedia-card--error">
      <img class="fedia-favicon" src="https://fedia.social/favicon.ico" alt="" width="24" height="24" loading="lazy" />
      <div class="fedia-error-body">
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="fedia-error-link"
        >
          View post on {displayName}
        </a>
      </div>
    </div>
  )}
</div>

